        "review-1": { "type": "testimonial", "settings": { "title": "Perfect way to unwind", "review_text": "<p>I was honestly a bit skeptical at first, but Munchief drinks completely changed my mind. The effect is smooth and relaxing without feeling overwhelming.</p>", "author_name": "Tina A", "rating_value": 5 } },
        "review-2": { "type": "testimonial", "settings": { "title": "New favorite snack", "review_text": "<p>Roasted, not fried, and the flavour is unreal. It disappears way too fast.</p>", "author_name": "Rahul M", "rating_value": 5 } },
        "review-3": { "type": "testimonial", "settings": { "title": "Delicious and light", "review_text": "<p>Tastes like street food but somehow doesn't feel heavy. The combo pack is the move.</p>", "author_name": "Priya S", "rating_value": 5 } },
        "review-4": { "type": "testimonial", "settings": { "title": "Fizzy and fun", "review_text": "<p>The prebiotic sodas are genuinely refreshing — Nimbu Jeera is my daily.</p>", "author_name": "Aditya K", "rating_value": 5 } },

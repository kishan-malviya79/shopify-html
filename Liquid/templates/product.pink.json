          "settings": {
            "question": "How long does shipping take?",
            "answer": "<p>Most orders dispatch within 24 hours and arrive in 3–6 business days, depending on your pincode. You can check serviceability right on this page before you order.</p>",
            "open_by_default": true
          }
        },
        "faq-2": {
          "type": "faq_item",
          "settings": {
            "question": "Is Salt Pop vegan?",
            "answer": "<p>Yes — every Munchief makhana flavour, including Salt Pop, is 100% vegan, roasted (not fried), and made with real ingredients.</p>"
          }
        },
        "faq-3": {
          "type": "faq_item",
          "settings": {
            "question": "How should I store it after opening?",
            "answer": "<p>Reseal the pouch or snap the tin's lid back on and keep it somewhere cool and dry. For maximum crunch, we'd finish it within 2–3 weeks of opening.</p>"
          }
        },
        "faq-4": {
          "type": "faq_item",
          "settings": {
            "question": "Can I return it if I don't like the flavour?",
            "answer": "<p>We offer a 7-day return window on unopened packs. If something arrived damaged, reach out and we'll sort a replacement or refund.</p>"
          }
        }

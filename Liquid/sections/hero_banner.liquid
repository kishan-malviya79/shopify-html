{% comment %}
  Section: hero_banner
  Source: sections/hero-banner.html + index.html
  CSS: css/sections/hero-banner.css (+ .stroke-heading, .btn-group in
  css/components.css)

  Settings:
    - IMAGES: background_image (image_picker), background_video (video),
      left_image (image_picker — product cutout bleeding off the left edge),
      right_image (image_picker — character cutout, right edge)
    - STYLE: background_type (select: image | sunburst | video),
      heading_style (select: outline | white), content_align
      (select: left | center), min_height (range)
    - COLOR: heading_color, text_color, overlay_opacity (range)
    - CONTENT: heading (text), text (richtext), button_label/button_link,
      icon_button_link (falls back to button_link)

  Blocks: none — single hero instance, no repeater content.

  Fonts: heading "Mouse Memoirs" (400), body "Comic Neue" (700) — load via
  the theme's font settings or a self-hosted @font-face.
{% endcomment %}

{{ 'section-hero-banner.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #shopify-section-{{ section.id }} .hero {
    min-height: {{ section.settings.min_height }}px;
  }
  #shopify-section-{{ section.id }} .hero__media img,
  #shopify-section-{{ section.id }} .hero__media video {
    opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
  }
  #shopify-section-{{ section.id }} .hero__heading {
    color: {{ section.settings.heading_color }};
  }
  #shopify-section-{{ section.id }} .hero__text {
    color: {{ section.settings.text_color }};
  }
  {% if section.settings.content_align == 'center' %}
    #shopify-section-{{ section.id }} .hero__content {
      margin-inline: auto;
      text-align: center;
    }
    #shopify-section-{{ section.id }} .hero__content .btn-group { justify-content: center; }
  {% endif %}
{%- endstyle -%}

<section class="hero" aria-label="Hero banner">

  {%- case section.settings.background_type -%}
    {%- when 'sunburst' -%}
      {% comment %} Pure CSS backdrop — no image asset needed. {% endcomment %}
      <div class="hero__media hero__media--sunburst" aria-hidden="true"></div>

    {%- when 'video' -%}
      <div class="hero__media" aria-hidden="true">
        {%- if section.settings.background_video != blank -%}
          {{ section.settings.background_video
             | video_tag: image_size: '1920x', autoplay: true, loop: true, muted: true, controls: false }}
        {%- endif -%}
      </div>

    {%- else -%}
      <div class="hero__media" aria-hidden="true">
        {%- if section.settings.background_image != blank -%}
          {{ section.settings.background_image
             | image_url: width: 2400
             | image_tag: alt: '', role: 'presentation', fetchpriority: 'high' }}
        {%- endif -%}
      </div>
  {%- endcase -%}

  {%- comment -%} Pre-composited transparent cutouts — no frame needed. {%- endcomment -%}
  {%- if section.settings.left_image != blank -%}
    <div class="hero__side hero__side--left">
      {{ section.settings.left_image | image_url: width: 1200 | image_tag: alt: '', role: 'presentation' }}
    </div>
  {%- endif -%}

  {%- if section.settings.right_image != blank -%}
    <div class="hero__side hero__side--right">
      {{ section.settings.right_image | image_url: width: 1200 | image_tag: alt: '', role: 'presentation' }}
    </div>
  {%- endif -%}

  <div class="hero__content">
    <h1 class="hero__heading stroke-heading{% if section.settings.heading_style == 'white' %} stroke-heading--white{% endif %}">
      {{ section.settings.heading }}
    </h1>

    <div class="hero__text">{{ section.settings.text }}</div>

    {%- if section.settings.button_label != blank -%}
      {%- assign icon_link = section.settings.icon_button_link | default: section.settings.button_link -%}
      <div class="btn-group">
        <a href="{{ section.settings.button_link | default: '#' }}" class="btn btn--pill btn--primary">{{ section.settings.button_label }}</a>

        <a href="{{ icon_link | default: '#' }}" class="btn btn--icon-circle btn--primary" aria-label="{{ section.settings.button_label | escape }}">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="7" y1="17" x2="17" y2="7"></line>
            <polyline points="7 7 17 7 17 17"></polyline>
          </svg>
        </a>
      </div>
    {%- endif -%}
  </div>

</section>

{% schema %}
{
  "name": "Hero banner",
  "tag": "div",
  "settings": [
    { "type": "header", "content": "Images" },
    {
      "type": "select",
      "id": "background_type",
      "label": "Background type",
      "options": [
        { "value": "image", "label": "Image" },
        { "value": "sunburst", "label": "Sunburst (CSS)" },
        { "value": "video", "label": "Video" }
      ],
      "default": "image"
    },
    { "type": "image_picker", "id": "background_image", "label": "Background image" },
    { "type": "video", "id": "background_video", "label": "Background video" },
    { "type": "image_picker", "id": "left_image", "label": "Left cutout" },
    { "type": "image_picker", "id": "right_image", "label": "Right cutout" },
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "This is not a snack.<br />This is a scene.", "info": "Use <br /> for a line break." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Roasted makhana with big Indian flavour and even bigger personality. Meet the Munchief family and find out which one you are.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop Now" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "url", "id": "icon_button_link", "label": "Icon button link", "info": "Falls back to the button link." },
    { "type": "header", "content": "Color" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#f6efdd" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#f6efdd" },
    { "type": "header", "content": "Style" },
    {
      "type": "select",
      "id": "heading_style",
      "label": "Heading style",
      "options": [
        { "value": "outline", "label": "Outline" },
        { "value": "white", "label": "White fill" }
      ],
      "default": "outline"
    },
    {
      "type": "select",
      "id": "content_align",
      "label": "Content alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    { "type": "range", "id": "min_height", "label": "Minimum height", "min": 400, "max": 1000, "step": 20, "unit": "px", "default": 720 },
    { "type": "range", "id": "overlay_opacity", "label": "Background opacity", "min": 20, "max": 100, "step": 5, "unit": "%", "default": 100 }
  ],
  "presets": [{ "name": "Hero banner" }]
}
{% endschema %}

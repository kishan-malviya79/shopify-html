{% comment %}
  Section: header
  Source: sections/header.html + index.html
  CSS: section-header.css (loaded here, this section only)
  JS:  header.js — imported page-wise (defer); toggles .is-open on the nav
       item, .has-menu-open on the header (fades in the scrim), and the
       mobile sheet
  Shared: .menu-card, .badge, .btn--pill, .btn--red live in components.css
  (loaded once in theme.liquid)

  Settings:
    - IMAGES: logo_image (image_picker), logo_link (url), logo_width (range)
    - CONTENT: bundle_cta_text/link, bundle_badge_text, show_bundle_badge,
      account_link, cart_link, mobile_menu (link_list), mobile_cta_text/link
    - COLOR: background_color, text_color, ribbon_color, cart_count_color,
      scrim_color
    - STYLE: sticky (checkbox), border_bottom (checkbox), nav_gap (range)

  Blocks:
    - theme block "nav_link" (repeatable, desktop nav) — each can hold
      nested "menu_card" blocks. See blocks/nav_link.liquid.
    - two STATIC "menu_card" blocks (ids mobile-promo-1 / mobile-promo-2)
      power the mobile sheet's peek-scroll promo row: the mobile layout is
      a second placement, and {% raw %}{% content_for "blocks" %}{% endraw %} can only render
      the dynamic nav_link blocks once.

  Cart count comes from Shopify's live cart object, not a setting — the
  bubble is hidden via opacity when 0, per the design spec.
{% endcomment %}

{{ 'section-header.css' | asset_url | stylesheet_tag }}
<script src="{{ 'header.js' | asset_url }}" defer></script>

{%- style -%}
  #shopify-section-{{ section.id }} .site-header {
    background-color: {{ section.settings.background_color }};
    color: {{ section.settings.text_color }};
    {% if section.settings.sticky %}position: sticky; top: 0; z-index: 100;{% endif %}
    {% unless section.settings.border_bottom %}border-bottom: 0;{% endunless %}
  }
  #shopify-section-{{ section.id }} .site-header__nav { gap: {{ section.settings.nav_gap }}px; }
  #shopify-section-{{ section.id }} .site-header__logo img { width: {{ section.settings.logo_width }}px; }
  #shopify-section-{{ section.id }} .site-header__ribbon { background-color: {{ section.settings.ribbon_color }}; }
  #shopify-section-{{ section.id }} .site-header__cart-count { background-color: {{ section.settings.cart_count_color }}; }
  #shopify-section-{{ section.id }} .site-header__scrim { background-color: {{ section.settings.scrim_color }}; }
{%- endstyle -%}

<header class="site-header">
  <div class="container site-header__inner">

    <nav class="site-header__nav" aria-label="Primary">
      {% content_for 'blocks' %}
    </nav>

    <a href="{{ section.settings.logo_link | default: routes.root_url }}" class="site-header__logo" aria-label="{{ shop.name | escape }} home">
      {%- if section.settings.logo_image != blank -%}
        {{ section.settings.logo_image | image_url: width: 600 | image_tag: alt: shop.name }}
      {%- else -%}
        <span>{{ shop.name }}</span>
      {%- endif -%}
    </a>

    <div class="site-header__actions">
      <a href="{{ section.settings.bundle_cta_link | default: '#' }}" class="site-header__action site-header__action--bundle">
        {%- if section.settings.show_bundle_badge -%}
          <span class="site-header__ribbon">{{ section.settings.bundle_badge_text }}</span>
        {%- endif -%}
        <span>{{ section.settings.bundle_cta_text }}</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="20 12 20 22 4 22 4 12"></polyline>
          <rect x="2" y="7" width="20" height="5"></rect>
          <line x1="12" y1="22" x2="12" y2="7"></line>
          <path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"></path>
          <path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"></path>
        </svg>
      </a>

      <a href="{{ section.settings.account_link | default: routes.account_url }}" class="site-header__action site-header__action--account">
        <span>Account</span>
        <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm0 1c-3 0-6 1.5-6 4v1h12v-1c0-2.5-3-4-6-4Z"/></svg>
      </a>

      <button type="button" class="site-header__action" data-cart-open aria-label="Cart, {{ cart.item_count }} items">
        <span>Cart</span>
        <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M4 6h8l-.6 7.7a1.3 1.3 0 0 1-1.3 1.2H5.9a1.3 1.3 0 0 1-1.3-1.2L4 6Z" fill="currentColor"/>
          <path d="M6 6V4.6a2 2 0 0 1 4 0V6" stroke="currentColor" stroke-width="1.3" fill="none"/>
        </svg>
        <span class="site-header__cart-count" data-count="{{ cart.item_count }}">{{ cart.item_count }}</span>
      </button>

      <button type="button" class="site-header__action site-header__burger" data-mobile-menu-toggle aria-label="Menu" aria-expanded="false" aria-controls="mobile-menu">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <line x1="4" y1="7" x2="20" y2="7"></line>
          <line x1="4" y1="12" x2="20" y2="12"></line>
          <line x1="4" y1="17" x2="20" y2="17"></line>
        </svg>
      </button>
    </div>

  </div>

  {%- comment -%} Mobile sheet — below 720px the nav row and mega menus are hidden. {%- endcomment -%}
  <div class="site-header__mobile-menu" id="mobile-menu">

    <nav class="site-header__mobile-links" aria-label="Mobile">
      {%- for link in section.settings.mobile_menu.links -%}
        <a href="{{ link.url }}" class="site-header__mobile-link">{{ link.title }}</a>
      {%- endfor -%}
      <a href="{{ section.settings.account_link | default: routes.account_url }}" class="site-header__mobile-link">My Account</a>
    </nav>

    <div class="site-header__mobile-promo">
      <div class="site-header__mobile-cards">
        {% content_for "block", type: "menu_card", id: "mobile-promo-1" %}
        {% content_for "block", type: "menu_card", id: "mobile-promo-2" %}
      </div>

      <a href="{{ section.settings.mobile_cta_link | default: '#' }}" class="btn btn--pill btn--red btn--block">{{ section.settings.mobile_cta_text }}</a>
    </div>

  </div>

  {%- comment -%} Page scrim behind an open mega menu. {%- endcomment -%}
  <div class="site-header__scrim" aria-hidden="true"></div>
</header>

{% schema %}
{
  "name": "Header",
  "tag": "div",
  "blocks": [{ "type": "nav_link" }, { "type": "menu_card" }],
  "settings": [
    { "type": "header", "content": "Images" },
    { "type": "image_picker", "id": "logo_image", "label": "Logo" },
    { "type": "url", "id": "logo_link", "label": "Logo link" },
    { "type": "range", "id": "logo_width", "label": "Logo width", "min": 80, "max": 320, "step": 4, "unit": "px", "default": 160 },
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "bundle_cta_text", "label": "Bundle CTA text", "default": "Build Your Bundle" },
    { "type": "url", "id": "bundle_cta_link", "label": "Bundle CTA link" },
    { "type": "checkbox", "id": "show_bundle_badge", "label": "Show bundle ribbon", "default": true },
    { "type": "text", "id": "bundle_badge_text", "label": "Ribbon text", "default": "Bestseller" },
    { "type": "url", "id": "account_link", "label": "Account link" },
    { "type": "url", "id": "cart_link", "label": "Cart link" },
    { "type": "link_list", "id": "mobile_menu", "label": "Mobile menu" },
    { "type": "text", "id": "mobile_cta_text", "label": "Mobile CTA text", "default": "Shop All" },
    { "type": "url", "id": "mobile_cta_link", "label": "Mobile CTA link" },
    { "type": "header", "content": "Color" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#f6efdd" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#2b2b2b" },
    { "type": "color", "id": "ribbon_color", "label": "Ribbon", "default": "#3aa757" },
    { "type": "color", "id": "cart_count_color", "label": "Cart count bubble", "default": "#e2241a" },
    { "type": "color", "id": "scrim_color", "label": "Menu scrim", "default": "rgba(0,0,0,0.45)" },
    { "type": "header", "content": "Style" },
    { "type": "checkbox", "id": "sticky", "label": "Sticky header", "default": false },
    { "type": "checkbox", "id": "border_bottom", "label": "Bottom border", "default": true },
    { "type": "range", "id": "nav_gap", "label": "Nav item gap", "min": 8, "max": 64, "step": 2, "unit": "px", "default": 24 }
  ]
}
{% endschema %}

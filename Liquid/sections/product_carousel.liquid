{% comment %}
  Section: product_carousel
  Source: sections/product-carousel.html + index.html (3 instances on the
  home page: "Meet the Munchief Family", "Munchief Sodas", and the combo
  rail, the last one with nav_style = "cta")
  CSS: css/sections/product-carousel.css

  Settings:
    - PRODUCT: collection (collection) — when set, cards render from the
      collection's products and the product_card blocks are ignored;
      products_to_show (range) caps how many
    - CONTENT: heading (text), anchor_id (text — the #hash the world_grid
      cards link to, e.g. "munchief-family")
    - STYLE: nav_style (select: arrows | cta), heading_font (select:
      display | stroke), cta_text/cta_link (used when nav_style = "cta"),
      cards_per_row (range), show_borders (checkbox)
    - COLOR: background_color, heading_color, card_background

  Blocks:
    - theme block "product_card" — see blocks/product_card.liquid
      (product, badge_text, badge_style, rating_value, rating_count,
      variant_label)

  Fonts: default heading "Anton"; the cta variant uses "Mouse Memoirs" via
  .stroke-heading.

  CSS/JS loading:
    - section-product-carousel.css is loaded HERE, by this section only.
    - Shared component CSS (.btn, .badge, .price, .rating, .select,
      .product-card) lives in components.css, loaded once in
      layout/theme.liquid so every block that reuses it gets it for free.
    - product-carousel.js is imported page-wise (defer) and binds every
      instance on the page, so 3 carousels still load one script.
{% endcomment %}

{{ 'section-product-carousel.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-carousel.js' | asset_url }}" defer></script>

{%- style -%}
  #shopify-section-{{ section.id }} .product-carousel {
    background-color: {{ section.settings.background_color }};
  }
  #shopify-section-{{ section.id }} .product-carousel__heading--display {
    color: {{ section.settings.heading_color }};
  }
  #shopify-section-{{ section.id }} .product-card {
    background-color: {{ section.settings.card_background }};
    {% unless section.settings.show_borders %}border: 0;{% endunless %}
  }
  @media (min-width: 900px) {
    #shopify-section-{{ section.id }} .product-carousel__track {
      grid-auto-columns: calc((100% - (var(--space-8, 32px) * {{ section.settings.cards_per_row | minus: 1 }})) / {{ section.settings.cards_per_row }});
    }
  }
{%- endstyle -%}

<section id="{{ section.settings.anchor_id | default: section.id }}" class="product-carousel" aria-label="{{ section.settings.heading | escape }}">
  <div class="container">

    <div class="product-carousel__header" data-animate="fade-up">
      <h2 class="product-carousel__heading--display{% if section.settings.heading_font == 'stroke' %} stroke-heading stroke-heading--black{% endif %}" data-animate="char-reveal">{{ section.settings.heading }}</h2>

      <div class="product-carousel__nav">
        {%- if section.settings.nav_style == 'cta' -%}
          <div class="btn-group">
            <a href="{{ section.settings.cta_link | default: '#' }}" class="btn btn--pill btn--outline">{{ section.settings.cta_text }}</a>
            <a href="{{ section.settings.cta_link | default: '#' }}" class="btn btn--icon-circle btn--outline" aria-label="{{ section.settings.cta_text | escape }}">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="7" y1="17" x2="17" y2="7"></line>
                <polyline points="7 7 17 7 17 17"></polyline>
              </svg>
            </a>
          </div>
        {%- else -%}
          <button type="button" class="btn btn--icon-circle btn--outline" data-carousel-prev aria-label="Previous product">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="15 6 9 12 15 18"></polyline>
            </svg>
          </button>
          <button type="button" class="btn btn--icon-circle btn--outline" data-carousel-next aria-label="Next product">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="9 6 15 12 9 18"></polyline>
            </svg>
          </button>
        {%- endif -%}
      </div>
    </div>

    <div class="product-carousel__track" data-carousel-track data-animate="fade-up-stagger">
      {%- if section.settings.collection != blank -%}
        {%- comment -%} Collection mode: cards come straight from the products. {%- endcomment -%}
        {%- for product in section.settings.collection.products limit: section.settings.products_to_show -%}
          <article class="product-card">
            <a href="{{ product.url }}" class="product-card__link">
              <div class="product-card__media">
                {%- if product.compare_at_price > product.price -%}
                  <span class="badge badge--green product-card__badge">Save {{ product.compare_at_price | minus: product.price | money }}</span>
                {%- endif -%}
                {%- if product.featured_image -%}
                  {{ product.featured_image | image_url: width: 800 | image_tag: alt: product.title, loading: 'lazy' }}
                {%- endif -%}
              </div>

              <h3 class="product-card__title">{{ product.title }}</h3>

              <div class="price">
                <span class="price__sale">{{ product.price | money }}</span>
                {%- if product.compare_at_price > product.price -%}
                  <span class="price__compare">{{ product.compare_at_price | money }}</span>
                {%- endif -%}
              </div>
            </a>

            <div class="select">
              <select class="select__input" aria-label="Variant" name="id">
                {%- for variant in product.variants -%}
                  <option value="{{ variant.id }}"{% unless variant.available %} disabled{% endunless %}>{{ variant.title }} &mdash; {{ variant.price | money }}</option>
                {%- endfor -%}
              </select>
              <svg class="select__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </div>

            <button type="button" class="btn btn--pill btn--red btn--block" data-add-to-cart>Add to Cart</button>
          </article>
        {%- endfor -%}
      {%- else -%}
        {% content_for 'blocks' %}
      {%- endif -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Product carousel",
  "tag": "div",
  "blocks": [{ "type": "product_card" }],
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Meet the Munchief Family" },
    { "type": "text", "id": "anchor_id", "label": "Anchor id", "info": "Used by in-page links, e.g. munchief-family." },
    { "type": "header", "content": "Products" },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "When set, cards render from this collection and the product card blocks are ignored." },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 2, "max": 12, "step": 1, "default": 6 },
    { "type": "header", "content": "Style" },
    {
      "type": "select",
      "id": "nav_style",
      "label": "Navigation",
      "options": [
        { "value": "arrows", "label": "Prev/next arrows" },
        { "value": "cta", "label": "CTA button pair" }
      ],
      "default": "arrows"
    },
    { "type": "text", "id": "cta_text", "label": "CTA text", "default": "Build Your Bundle" },
    { "type": "url", "id": "cta_link", "label": "CTA link" },
    {
      "type": "select",
      "id": "heading_font",
      "label": "Heading style",
      "options": [
        { "value": "display", "label": "Display (Anton)" },
        { "value": "stroke", "label": "Stroked (Mouse Memoirs)" }
      ],
      "default": "display"
    },
    { "type": "range", "id": "cards_per_row", "label": "Cards per row (desktop)", "min": 2, "max": 5, "step": 1, "default": 3 },
    { "type": "checkbox", "id": "show_borders", "label": "Card borders", "default": true },
    { "type": "header", "content": "Color" },
    { "type": "color", "id": "background_color", "label": "Section background", "default": "#f6efdd" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#2b2b2b" },
    { "type": "color", "id": "card_background", "label": "Card background", "default": "#ffffff" }
  ],
  "presets": [{ "name": "Product carousel" }]
}
{% endschema %}

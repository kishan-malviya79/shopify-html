{% comment %}
  Section: collection_grid
  Source: sections/shop-all.html
  CSS: css/sections/shop-all.css -> assets/section-shop-all.css
  Templates: templates/page.shop-all.json (block-driven "Shop All" page) and
  templates/collection.json (real collection pages, product_source =
  "collection")

  Settings:
    - CONTENT: heading (text), empty_text (text)
    - BREADCRUMB: show_breadcrumb (checkbox), breadcrumb_home_label (text),
      breadcrumb_home_link (url), breadcrumb_current_label (text)
    - PRODUCTS: product_source (select: auto | blocks | collection) —
      "collection" ignores the blocks and renders the template's
      `collection` as one grid; "auto" does that for real collections but
      keeps the blocks on /collections/all; products_to_show caps the grid
    - FILTERS: show_filters (checkbox), all_filter_label (text)
    - STYLE: columns (range, desktop grid columns), padding_top,
      padding_bottom
    - COLOR: background_color, heading_color, breadcrumb_color

  Blocks:
    - theme block "collection_group" — see blocks/collection_group.liquid
      (heading, filter_label, filter_key, collection, heading_color, and
      nested "product_card" blocks)

  Filter tabs are built from the blocks themselves: each collection_group
  contributes one tab (its filter_label, or its heading), so adding a group
  adds a tab and deleting a group deletes the tab — the Combos tab can
  never outlive the Combos group. The leading "All" tab is the section's
  own. assets/collection-grid.js does the toggling, and back-fills a tab
  for any group that rendered without one.

  Fonts: page title uses "Anton" (--font-heading-bold, same voice as
  product_carousel's heading); group headings use "Fredoka"; breadcrumb,
  price and rating text use "Inter".

  CSS/JS loading:
    - section-shop-all.css is loaded HERE, by this section only.
    - Shared component CSS (.container, .breadcrumb, .filter-tabs,
      .product-grid, .product-card, .btn, .badge, .price, .rating,
      .select) lives in components.css, loaded once in layout/theme.liquid.
    - collection-grid.js is imported page-wise (defer) and binds every
      instance on the page.
{% endcomment %}

{{ 'section-shop-all.css' | asset_url | stylesheet_tag }}
<script src="{{ 'collection-grid.js' | asset_url }}" defer></script>

{%- style -%}
  #shopify-section-{{ section.id }} .collection {
    background-color: {{ section.settings.background_color }};
    padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px;
  }
  #shopify-section-{{ section.id }} .collection__heading {
    color: {{ section.settings.heading_color }};
  }
  #shopify-section-{{ section.id }} .breadcrumb {
    color: {{ section.settings.breadcrumb_color }};
  }
  /* Above components.css's 1024px tablet breakpoint, so the shared 2-up
     tablet rule still wins where it should. */
  @media (min-width: 1025px) {
    #shopify-section-{{ section.id }} .product-grid {
      grid-template-columns: repeat({{ section.settings.columns }}, minmax(0, 1fr));
    }
  }
{%- endstyle -%}

{%- liquid
  # /collections/all is Shopify's virtual all-products collection: no admin
  # record, so collection.id is nil. That URL is the store's Shop All page,
  # so "auto" renders the designed groups there and real products elsewhere.
  assign is_all_products = false
  if collection != blank and collection.id == blank
    assign is_all_products = true
  elsif collection.handle == 'all'
    assign is_all_products = true
  endif

  assign use_collection = false
  if collection != blank
    if section.settings.product_source == 'collection'
      assign use_collection = true
    elsif section.settings.product_source == 'auto' and is_all_products == false
      assign use_collection = true
    endif
  endif

  if use_collection
    assign heading = collection.title | default: section.settings.heading
  else
    assign heading = section.settings.heading | default: collection.title
  endif
-%}

<section class="collection" aria-label="{{ heading | escape }}">
  <div class="container collection__inner">

    {%- if section.settings.show_breadcrumb -%}
      <nav class="breadcrumb collection__breadcrumb" aria-label="Breadcrumb">
        <a href="{{ section.settings.breadcrumb_home_link | default: routes.root_url }}" class="breadcrumb__link">{{ section.settings.breadcrumb_home_label }}</a>
        <span class="breadcrumb__sep">&gt;</span>
        <span class="breadcrumb__current">{{ section.settings.breadcrumb_current_label | default: heading }}</span>
      </nav>
    {%- endif -%}

    {%- if heading != blank -%}
      <h1 class="collection__heading">{{ heading }}</h1>
    {%- endif -%}

    {%- if section.settings.show_filters and use_collection == false -%}
      {%- comment -%}
        One tab per collection_group block, in block order, plus the
        section's own "All" tab in front.
      {%- endcomment -%}
      <div class="filter-tabs collection__filters" role="group" aria-label="Filter products by category" data-collection-filters>
        <button type="button" class="filter-tab is-active" data-filter="all" aria-pressed="true">{{ section.settings.all_filter_label }}</button>
        {%- for block in section.blocks -%}
          {%- if block.type == 'collection_group' -%}
            {%- liquid
              assign group_key = block.settings.filter_key | default: block.settings.heading | handleize
              assign group_label = block.settings.filter_label | default: block.settings.heading
            -%}
            <button type="button" class="filter-tab" data-filter="{{ group_key }}" aria-pressed="false">{{ group_label }}</button>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="collection__groups">
      {%- if use_collection -%}
        {%- comment -%}
          Collection mode: one unlabelled grid straight off the template's
          collection — used by templates/collection.json, where the groups
          and their tabs make no sense.
        {%- endcomment -%}
        <div class="collection__group" data-category="all">
          <div class="product-grid">
            {%- for product in collection.products limit: section.settings.products_to_show -%}
              <article class="product-card">
                <a href="{{ product.url }}" class="product-card__link">
                  <div class="product-card__media">
                    {%- if product.compare_at_price > product.price -%}
                      <span class="badge badge--green product-card__badge">Save {{ product.compare_at_price | minus: product.price | money }}</span>
                    {%- endif -%}
                    {%- if product.featured_image -%}
                      {{ product.featured_image | image_url: width: 800 | image_tag: alt: product.title, loading: 'lazy' }}
                    {%- endif -%}
                  </div>

                  <h3 class="product-card__title">{{ product.title }}</h3>

                  <div class="price">
                    <span class="price__sale">{{ product.price | money }}</span>
                    {%- if product.compare_at_price > product.price -%}
                      <span class="price__compare">{{ product.compare_at_price | money }}</span>
                    {%- endif -%}
                  </div>
                </a>

                <div class="select">
                  <select class="select__input" aria-label="Variant" name="id" data-variant-select>
                    {%- for variant in product.variants -%}
                      <option value="{{ variant.id }}"{% unless variant.available %} disabled{% endunless %}>{{ variant.title }} &mdash; {{ variant.price | money }}</option>
                    {%- endfor -%}
                  </select>
                  <svg class="select__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <polyline points="6 9 12 15 18 9"></polyline>
                  </svg>
                </div>

                <button type="button" class="btn btn--pill btn--red btn--block" data-add-to-cart>Add to Cart</button>
              </article>
            {%- endfor -%}
          </div>
        </div>
      {%- else -%}
        {% content_for 'blocks' %}
      {%- endif -%}
    </div>

    {%- comment -%}
      Hidden by default; collection-grid.js reveals it when a tab matches no
      group. On a collection template there are no tabs, so an empty
      collection has to render it server-side instead.
    {%- endcomment -%}
    <p class="collection__empty" data-collection-empty{% unless use_collection and collection.products.size == 0 %} hidden{% endunless %}>{{ section.settings.empty_text }}</p>

  </div>
</section>

{% schema %}
{
  "name": "Collection grid",
  "tag": "div",
  "blocks": [{ "type": "collection_group" }],
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop All", "info": "Leave blank on a collection template to use the collection title." },
    { "type": "text", "id": "empty_text", "label": "Empty state", "default": "No products in this category yet." },
    { "type": "header", "content": "Breadcrumb" },
    { "type": "checkbox", "id": "show_breadcrumb", "label": "Show breadcrumb", "default": true },
    { "type": "text", "id": "breadcrumb_home_label", "label": "Home label", "default": "Home" },
    { "type": "url", "id": "breadcrumb_home_link", "label": "Home link" },
    { "type": "text", "id": "breadcrumb_current_label", "label": "Current page label", "default": "Shop all" },
    { "type": "header", "content": "Products" },
    {
      "type": "select",
      "id": "product_source",
      "label": "Products from",
      "options": [
        { "value": "auto", "label": "Auto (groups on /collections/all)" },
        { "value": "blocks", "label": "Collection group blocks" },
        { "value": "collection", "label": "This collection (collection template)" }
      ],
      "default": "blocks",
      "info": "Auto renders the collection group blocks on /collections/all and this collection's own products anywhere else."
    },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 4, "max": 50, "step": 2, "default": 24, "info": "Collection mode only." },
    { "type": "header", "content": "Filters" },
    { "type": "checkbox", "id": "show_filters", "label": "Show category tabs", "default": true },
    { "type": "text", "id": "all_filter_label", "label": "All tab label", "default": "All" },
    { "type": "header", "content": "Style" },
    { "type": "range", "id": "columns", "label": "Columns (desktop)", "min": 2, "max": 5, "step": 1, "default": 3 },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 96 },
    { "type": "header", "content": "Color" },
    { "type": "color", "id": "background_color", "label": "Section background", "default": "#f6efdd" },
    { "type": "color", "id": "heading_color", "label": "Page title", "default": "#2b2b2b" },
    { "type": "color", "id": "breadcrumb_color", "label": "Breadcrumb", "default": "#6b6257" }
  ],
  "presets": [{ "name": "Collection grid" }]
}
{% endschema %}

{% comment %}
  Section: world_band
  Source: sections/about.html (2 instances: "Crunch World", "Prebiotic World")
  CSS: section-world-band.css (loaded here, this section only)
  Shared: .band, .band__media, .badge--green, .btn--pill, .btn--icon-circle,
  .btn-group live in components.css

  A full-bleed band where the product scene IS the background photo, with the
  heading, blurb, ingredient chips and a Shop Now CTA stacked over its left
  half. Distinct from `world_grid`, the homepage's two-up card layout.

  `color_scheme` picks the band's whole skin:
    - "crunch"    — orange band, white copy
    - "prebiotic" — cream band, red copy with a white outline, and the taller
                    top padding the design gives the page's last band
  The color pickers below are left blank on purpose: a filled picker emits an
  id-scoped rule that wins over the scheme class, so set one only to depart
  from the scheme.

  Settings:
    - CONTENT: heading (text), text (richtext), cta_text (text),
      cta_link (url), image (image_picker)
    - STYLE: color_scheme (select), is_last_band (checkbox),
      min_height (range)
    - COLOR (optional overrides): background_color, heading_color, text_color

  Blocks:
    - theme block "tag" — a `.badge--green` ingredient chip.
      See blocks/tag.liquid.
{% endcomment %}

{{ 'section-world-band.css' | asset_url | stylesheet_tag }}

{%- style -%}
  {%- if section.settings.background_color != blank -%}
    #shopify-section-{{ section.id }} .world-band { background-color: {{ section.settings.background_color }}; }
  {%- endif -%}
  {%- if section.settings.heading_color != blank -%}
    #shopify-section-{{ section.id }} .world-band__heading { color: {{ section.settings.heading_color }}; }
  {%- endif -%}
  {%- if section.settings.text_color != blank -%}
    #shopify-section-{{ section.id }} .world-band__text { color: {{ section.settings.text_color }}; }
  {%- endif -%}
  /* The stylesheet reflows this band below 860px; an id-scoped rule would win
     over that media query, so the merchant height applies above it. */
  @media (min-width: 861px) {
    #shopify-section-{{ section.id }} .world-band {
      min-height: clamp(420px, 61vw, {{ section.settings.min_height }}px);
    }
  }
{%- endstyle -%}

{%- liquid
  assign band_class = 'band'
  if section.settings.is_last_band
    assign band_class = band_class | append: ' band--last'
  endif
  assign band_class = band_class | append: ' world-band'
  if section.settings.color_scheme == 'prebiotic'
    assign band_class = band_class | append: ' world-band--prebiotic'
  endif
-%}

<section class="{{ band_class }}" aria-label="{{ section.settings.heading | strip_html | default: 'World' }}">

  <div class="band__media">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 2400 | image_tag: alt: '', role: 'presentation', loading: 'lazy', sizes: '100vw' }}
    {%- endif -%}
  </div>

  <div class="world-band__body">
    <h2 class="world-band__heading">{{ section.settings.heading }}</h2>
    <div class="world-band__text">{{ section.settings.text }}</div>

    <div class="world-band__tags">
      {% content_for 'blocks' %}
    </div>

    {%- if section.settings.cta_text != blank -%}
      <div class="btn-group">
        <a href="{{ section.settings.cta_link | default: '#' }}" class="btn btn--pill btn--outline world-band__cta">{{ section.settings.cta_text }}</a>
        <a href="{{ section.settings.cta_link | default: '#' }}" class="btn btn--icon-circle btn--outline world-band__cta" aria-label="{{ section.settings.cta_text }} — {{ section.settings.heading | strip_html }}">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="7" y1="17" x2="17" y2="7"></line>
            <polyline points="7 7 17 7 17 17"></polyline>
          </svg>
        </a>
      </div>
    {%- endif -%}
  </div>

</section>

{% schema %}
{
  "name": "World band",
  "tag": "div",
  "blocks": [{ "type": "tag" }],
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Crunch World" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Five real people, five roasted makhana flavours, each one built around an actual mood — not an invented mascot. Big Indian street-food energy, roasted not fried.</p>" },
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "text", "id": "cta_text", "label": "Button label", "default": "Shop Now" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "header", "content": "Style" },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "crunch", "label": "Crunch — orange band, white copy" },
        { "value": "prebiotic", "label": "Prebiotic — cream band, outlined red copy" }
      ],
      "default": "crunch"
    },
    { "type": "checkbox", "id": "is_last_band", "label": "Last band on the page", "default": false, "info": "Rounds the bottom corners instead of running into the band below." },
    { "type": "range", "id": "min_height", "label": "Minimum height", "min": 400, "max": 1000, "step": 20, "unit": "px", "default": 880 },
    { "type": "header", "content": "Color" },
    { "type": "color", "id": "background_color", "label": "Band background", "info": "Leave blank to use the colour scheme." },
    { "type": "color", "id": "heading_color", "label": "Heading", "info": "Leave blank to use the colour scheme." },
    { "type": "color", "id": "text_color", "label": "Text", "info": "Leave blank to use the colour scheme." }
  ],
  "presets": [{ "name": "World band", "blocks": [{ "type": "tag" }, { "type": "tag" }, { "type": "tag" }] }]
}
{% endschema %}

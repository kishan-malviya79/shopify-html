{% comment %}
  Section: about_hero
  Source: sections/about.html (breadcrumb strip + first band)
  CSS: section-about-hero.css (loaded here, this section only)
  Shared: .band, .band--first, .band__media, .band__inner, .breadcrumb
  live in components.css (loaded once in theme.liquid)

  The first `.band` of the About page: a full-bleed character photo with a
  centred display headline + one-line subtitle in the photo's open sky, and
  a rotated "100% Vegetarian" seal. The cream breadcrumb strip sits above
  the band, inside this section, so the trail never lands on the photo.

  Settings:
    - CONTENT: heading (text), text (richtext)
    - BREADCRUMB: show_breadcrumb (checkbox), breadcrumb_home_label (text),
      breadcrumb_home_link (url), breadcrumb_current_label (text)
    - SEAL: show_seal (checkbox), seal_value (text), seal_label (text)
    - IMAGE: image (image_picker)
    - STYLE: min_height (range), padding_top / padding_bottom (range)
    - COLOR: background_color (fallback behind the photo), heading_color,
      text_color, seal_background, seal_text_color, breadcrumb_background

  Blocks: none
{% endcomment %}

{{ 'section-about-hero.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #shopify-section-{{ section.id }} .about-breadcrumb {
    background-color: {{ section.settings.breadcrumb_background }};
  }
  #shopify-section-{{ section.id }} .about-hero {
    background-color: {{ section.settings.background_color }};
  }
  /* The stylesheet drops both values on phones; an id-scoped rule would win
     over that media query, so the merchant values apply from 641px up. */
  @media (min-width: 641px) {
    #shopify-section-{{ section.id }} .about-hero {
      padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px;
    }
    #shopify-section-{{ section.id }} .about-hero__inner {
      min-height: clamp(320px, 46vw, {{ section.settings.min_height }}px);
    }
  }
  #shopify-section-{{ section.id }} .about-hero__heading {
    color: {{ section.settings.heading_color }};
  }
  #shopify-section-{{ section.id }} .about-hero__text {
    color: {{ section.settings.text_color }};
  }
  #shopify-section-{{ section.id }} .about-hero__seal {
    background-color: {{ section.settings.seal_background }};
  }
  #shopify-section-{{ section.id }} .about-hero__seal-value,
  #shopify-section-{{ section.id }} .about-hero__seal-label {
    color: {{ section.settings.seal_text_color }};
  }
{%- endstyle -%}

{%- if section.settings.show_breadcrumb -%}
  <div class="about-breadcrumb">
    <nav class="breadcrumb container" aria-label="Breadcrumb">
      <a href="{{ section.settings.breadcrumb_home_link | default: routes.root_url }}" class="breadcrumb__link">{{ section.settings.breadcrumb_home_label }}</a>
      <span class="breadcrumb__sep">&gt;</span>
      <span class="breadcrumb__current">{{ section.settings.breadcrumb_current_label | default: page.title }}</span>
    </nav>
  </div>
{%- endif -%}

<section class="band band--first about-hero" aria-label="{{ section.settings.heading | strip_html | default: 'About us' }}">

  <div class="band__media">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 2400 | image_tag: alt: '', role: 'presentation', sizes: '100vw' }}
    {%- endif -%}
  </div>

  {%- if section.settings.show_seal -%}
    <div class="about-hero__seal">
      <span class="about-hero__seal-value">{{ section.settings.seal_value }}</span>
      <span class="about-hero__seal-label">{{ section.settings.seal_label }}</span>
    </div>
  {%- endif -%}

  <div class="band__inner about-hero__inner">
    <h1 class="about-hero__heading" data-animate="char-reveal">{{ section.settings.heading }}</h1>
    <div class="about-hero__text">{{ section.settings.text }}</div>
  </div>

</section>

{% schema %}
{
  "name": "About hero",
  "tag": "div",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "We built a snack brand<br />around real people.", "info": "Use <br /> for a line break." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Five personalities. Five flavours. Two worlds. Zero boring snacks.</p>" },
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "header", "content": "Breadcrumb" },
    { "type": "checkbox", "id": "show_breadcrumb", "label": "Show breadcrumb", "default": true },
    { "type": "text", "id": "breadcrumb_home_label", "label": "Home label", "default": "Home" },
    { "type": "url", "id": "breadcrumb_home_link", "label": "Home link" },
    { "type": "text", "id": "breadcrumb_current_label", "label": "Current page label", "default": "About Us" },
    { "type": "header", "content": "Seal" },
    { "type": "checkbox", "id": "show_seal", "label": "Show seal", "default": true },
    { "type": "text", "id": "seal_value", "label": "Seal value", "default": "100%" },
    { "type": "text", "id": "seal_label", "label": "Seal label", "default": "Vegetarian" },
    { "type": "header", "content": "Color" },
    { "type": "color", "id": "breadcrumb_background", "label": "Breadcrumb strip", "default": "#f6efdd" },
    { "type": "color", "id": "background_color", "label": "Band background", "default": "#7cb8e2", "info": "Shows behind the photo while it loads, and on any crop it doesn't cover." },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#f83e1c" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#5f0e00" },
    { "type": "color", "id": "seal_background", "label": "Seal background", "default": "#f83e1c" },
    { "type": "color", "id": "seal_text_color", "label": "Seal text", "default": "#ffffff" },
    { "type": "header", "content": "Style" },
    { "type": "range", "id": "min_height", "label": "Copy area height", "min": 200, "max": 800, "step": 20, "unit": "px", "default": 660 },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 82 }
  ],
  "presets": [{ "name": "About hero" }]
}
{% endschema %}

{% comment %}
  Section: brand_story
  Source: sections/brand-story.html + index.html
  CSS: section-brand-story.css (loaded here, used by this section only)
  Shared: .stroke-heading, .btn-group, .btn--pill, .btn--icon-circle,
  .btn--outline live in components.css (loaded once in theme.liquid)

  Settings:
    - IMAGES: hero_image (image_picker — woman with pouch + can),
      characters_image (image_picker — the 5 flavour characters)
    - CONTENT: heading (richtext-style text with <br />), subheading,
      text (richtext), cta_text, cta_link, anchor_id
    - COLOR: background_color, heading_color, subheading_color,
      text_color, cta_color (--color-cta-ink override)
    - STYLE: layout (select: image_right | image_left), corner_radius,
      padding_block

  Blocks: none — single brand-story instance, no repeater content.

  Fonts: heading "Mouse Memoirs" via .stroke-heading; subheading "Fredoka"
  500; body "Comic Neue".
{% endcomment %}

{{ 'section-brand-story.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #shopify-section-{{ section.id }} .brand-story {
    background-color: {{ section.settings.background_color }};
    padding-block: {{ section.settings.padding_block }}px;
  }
  #shopify-section-{{ section.id }} .brand-story__heading { color: {{ section.settings.heading_color }}; }
  #shopify-section-{{ section.id }} .brand-story__subheading { color: {{ section.settings.subheading_color }}; }
  #shopify-section-{{ section.id }} .brand-story__text { color: {{ section.settings.text_color }}; }
  #shopify-section-{{ section.id }} .brand-story__cta { --color-cta-ink: {{ section.settings.cta_color }}; }
  #shopify-section-{{ section.id }} .brand-story__photo img,
  #shopify-section-{{ section.id }} .brand-story__characters img {
    border-radius: {{ section.settings.corner_radius }}px;
  }
  {% if section.settings.layout == 'image_left' %}
    #shopify-section-{{ section.id }} .brand-story__row--intro { flex-direction: row-reverse; }
    #shopify-section-{{ section.id }} .brand-story__row--about { flex-direction: row-reverse; }
  {% endif %}
{%- endstyle -%}

<section id="{{ section.settings.anchor_id | default: section.id }}" class="brand-story" aria-label="About the brand">

  <div class="container brand-story__row brand-story__row--intro">
    <h2 class="brand-story__heading stroke-heading" data-animate="char-reveal">{{ section.settings.heading }}</h2>

    {%- if section.settings.hero_image != blank -%}
      <div class="brand-story__photo">
        {{ section.settings.hero_image | image_url: width: 1400 | image_tag: alt: section.settings.hero_image.alt, loading: 'lazy' }}
      </div>
    {%- endif -%}
  </div>

  <div class="container brand-story__row brand-story__row--about">
    {%- if section.settings.characters_image != blank -%}
      <div class="brand-story__characters">
        {{ section.settings.characters_image | image_url: width: 1400 | image_tag: alt: section.settings.characters_image.alt, loading: 'lazy' }}
      </div>
    {%- endif -%}

    <div class="brand-story__content">
      <h3 class="brand-story__subheading">{{ section.settings.subheading }}</h3>

      <div class="brand-story__text">{{ section.settings.text }}</div>

      {%- if section.settings.cta_text != blank -%}
        <div class="btn-group">
          <a href="{{ section.settings.cta_link | default: '#' }}" class="btn btn--pill btn--outline brand-story__cta">{{ section.settings.cta_text }}</a>
          <a href="{{ section.settings.cta_link | default: '#' }}" class="btn btn--icon-circle btn--outline brand-story__cta" aria-label="{{ section.settings.cta_text | escape }}">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="7" y1="17" x2="17" y2="7"></line>
              <polyline points="7 7 17 7 17 17"></polyline>
            </svg>
          </a>
        </div>
      {%- endif -%}
    </div>
  </div>

</section>

{% schema %}
{
  "name": "Brand story",
  "tag": "div",
  "settings": [
    { "type": "header", "content": "Images" },
    { "type": "image_picker", "id": "hero_image", "label": "Hero photo" },
    { "type": "image_picker", "id": "characters_image", "label": "Characters photo" },
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Crunch it.<br />Sip it.<br />Repeat.", "info": "Use <br /> for a line break." },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "5 Characters. 5 Flavours.<br />Zero Boring Snacks." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Munchief started with a simple idea: snacking should feel like a personality, not a nutrition label.</p>" },
    { "type": "text", "id": "cta_text", "label": "CTA text", "default": "About Munchiefam" },
    { "type": "url", "id": "cta_link", "label": "CTA link" },
    { "type": "text", "id": "anchor_id", "label": "Anchor id", "info": "e.g. our-story" },
    { "type": "header", "content": "Color" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#f6efdd" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#e2241a" },
    { "type": "color", "id": "subheading_color", "label": "Subheading", "default": "#2b2b2b" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#2b2b2b" },
    { "type": "color", "id": "cta_color", "label": "CTA ink", "default": "#7a4a2b" },
    { "type": "header", "content": "Style" },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "image_right", "label": "Image right" },
        { "value": "image_left", "label": "Image left" }
      ],
      "default": "image_right"
    },
    { "type": "range", "id": "corner_radius", "label": "Image corner radius", "min": 0, "max": 64, "step": 2, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_block", "label": "Vertical padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 64 }
  ],
  "presets": [{ "name": "Brand story" }]
}
{% endschema %}

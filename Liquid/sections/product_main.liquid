{% comment %}
  Section: product_main
  Source: sections/product-main.html (the PDP buy box — everything above
  product_story on that page)
  CSS: css/sections/product-main.css

  Two-column buy box: gallery + thumbnail rail on the left, the buy column
  on the right (eyebrow, title, rating, description, price, variant pills,
  qty + add to cart, checkout note, pincode checker, trust badges, and a
  "Must Try" cross-sell card).

  Settings:
    - PRODUCT: product (product) — title, price, compare_at_price, media
      and variants all come from here; leave it blank on a product template
      and the page's own product is used
    - CONTENT: eyebrow_text, description (richtext), rating_value,
      rating_count, reviews_anchor (text — the #hash product_reviews owns),
      tax_note, variants_label, checkout_note, show_chat_button
    - PINCODE: show_pincode_checker, pincode_placeholder,
      pincode_button_label
    - UPSELL: upsell_product (product — blank hides the whole card),
      upsell_heading, upsell_badge, upsell_text, upsell_button_label
    - STYLE: thumbnail_columns (range), color_scheme (select)
    - COLOR: background_color, media_background, title_color

  Blocks — three types landing in three different containers, so they are
  placed as STATIC blocks by id rather than through a single
  {% content_for 'blocks' %} (which can only be called once). Same
  technique flavor_quiz already uses; the ids below are the ones
  templates/product.json declares:
    - "gallery_image"  x4 — gallery-1 … gallery-4 (thumbnail rail)
    - "variant_option" x2 — variant-1, variant-2 (weight/size pills;
      each takes a variant ID as text — Shopify has no product_variant
      setting type)
    - "trust_badge"    x4 — trust-1 … trust-4 (reassurance row)
  Adding a 5th thumb = one more content_for line here + one more entry in
  the template.

  Color scheme: `color_scheme: pink` renders the `theme-pink` class (see
  assets/tokens.css) on this section's root. That class only re-points
  color tokens, so the pink PDP costs no duplicated CSS — the static
  build's sections/product-main-pink.html is this same section with the
  setting flipped, and every other PDP section carries the same setting.

  CSS/JS loading:
    - section-product-main.css is loaded HERE, by this section only.
    - Shared component CSS (.rating, .price, .badge, .variant-pill,
      .qty-stepper, .pincode-form, .trust-badge, .upsell-card, .btn) lives
      in components.css, loaded once in layout/theme.liquid.
    - product-main.js is imported page-wise (defer): thumbnail swaps the
      main image, variant pill re-labels the Add to cart button, qty
      stepper counts. It binds every .product-main on the page.
{% endcomment %}

{{ 'section-product-main.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-main.js' | asset_url }}" defer></script>

{%- liquid
  assign pdp_product = section.settings.product | default: product
  assign current_variant = pdp_product.selected_or_first_available_variant
  # The product's own review metafields win when a reviews app has
  # published them; the settings are what the design shows until then.
  assign rating = section.settings.rating_value
  assign rating_count = section.settings.rating_count

  assign rating_metafield = pdp_product.metafields.reviews.rating
  if rating_metafield != blank and rating_metafield.value.rating != blank
    assign rating = rating_metafield.value.rating
  endif

  assign count_metafield = pdp_product.metafields.reviews.rating_count
  if count_metafield != blank
    assign rating_count = count_metafield
  endif

  assign full_stars = rating | floor
  assign partial_star = full_stars | plus: 1
  assign upsell = section.settings.upsell_product
-%}

{%- comment -%}
  The color pickers below only apply on the default scheme. `theme-pink`
  works by re-pointing the color TOKENS this section's CSS reads, so
  hardcoding the same properties here would win over the class and the pink
  PDP would come out cream. One or the other, never both.
{%- endcomment -%}
{%- style -%}
  {% if section.settings.color_scheme == 'default' %}
    #shopify-section-{{ section.id }} .product-main {
      background-color: {{ section.settings.background_color }};
    }
    #shopify-section-{{ section.id }} .product-main__media {
      background-color: {{ section.settings.media_background }};
    }
    #shopify-section-{{ section.id }} .product-main__title {
      color: {{ section.settings.title_color }};
    }
  {% endif %}
  #shopify-section-{{ section.id }} .product-main__thumbs {
    grid-template-columns: repeat({{ section.settings.thumbnail_columns }}, 1fr);
  }
{%- endstyle -%}

<section class="product-main{% if section.settings.color_scheme == 'pink' %} theme-pink{% endif %}" aria-label="Product details">
  <div class="container">
    <div class="product-main__layout">

      {%- comment -%} Gallery -------------------------------------------- {%- endcomment -%}
      <div class="product-main__gallery">
        <div class="product-main__media">
          {%- if section.settings.show_chat_button -%}
            <button type="button" class="product-main__chat" aria-label="Chat with us">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
              </svg>
            </button>
          {%- endif -%}

          {%- comment -%}
            Empty until a product image exists: product-main.js then fills
            it from the first gallery_image block, so the viewer always
            matches the thumb it marks active.
          {%- endcomment -%}
          <img data-gallery-main src="{{ pdp_product.featured_image | image_url: width: 1200 }}" alt="{{ pdp_product.title | escape }}" />
        </div>

        <div class="product-main__thumbs">
          {% content_for "block", type: "gallery_image", id: "gallery-1" %}
          {% content_for "block", type: "gallery_image", id: "gallery-2" %}
          {% content_for "block", type: "gallery_image", id: "gallery-3" %}
          {% content_for "block", type: "gallery_image", id: "gallery-4" %}
        </div>
      </div>

      {%- comment -%} Buy box -------------------------------------------- {%- endcomment -%}
      <div class="product-main__info">
        <p class="product-main__eyebrow">{{ section.settings.eyebrow_text }}</p>
        <h1 class="product-main__title">{{ pdp_product.title }}</h1>

        <div class="rating">
          <span class="rating__stars" aria-hidden="true">
            {%- for i in (1..5) -%}
              {%- if i <= full_stars -%}
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 .587l3.668 7.431L24 9.168l-6 5.847L19.335 24 12 19.897 4.665 24 6 15.015 0 9.168l8.332-1.15z"/></svg>
              {%- elsif i == partial_star and rating > full_stars -%}
                <svg class="rating__star--partial" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .587l3.668 7.431L24 9.168l-6 5.847L19.335 24 12 19.897 4.665 24 6 15.015 0 9.168l8.332-1.15z"/></svg>
              {%- endif -%}
            {%- endfor -%}
          </span>
          <a href="#{{ section.settings.reviews_anchor }}" class="rating__count">({{ rating }} out of 5) &nbsp;&middot;&nbsp; {{ rating_count }} Ratings</a>
        </div>

        <div class="product-main__description">{{ section.settings.description }}</div>

        <div class="price product-main__price">
          <span class="price__sale">{{ current_variant.price | money }}</span>
          {%- if current_variant.compare_at_price > current_variant.price -%}
            {%- assign saving = current_variant.compare_at_price | minus: current_variant.price -%}
            <span class="price__compare">{{ current_variant.compare_at_price | money }}</span>
            <span class="badge badge--green">Save {{ saving | money }}</span>
          {%- endif -%}
        </div>
        <p class="product-main__tax-note">{{ section.settings.tax_note }}</p>

        <div class="product-main__variants">
          <span class="product-main__variants-label">{{ section.settings.variants_label }}</span>
          <div class="variant-pills">
            {% content_for "block", type: "variant_option", id: "variant-1" %}
            {% content_for "block", type: "variant_option", id: "variant-2" %}
          </div>
        </div>

        <div class="product-main__cart-row">
          <div class="qty-stepper">
            <button type="button" class="qty-stepper__btn" data-qty-decrease aria-label="Decrease quantity">&minus;</button>
            <span class="qty-stepper__value" data-qty-value>1</span>
            <button type="button" class="qty-stepper__btn" data-qty-increase aria-label="Increase quantity">+</button>
          </div>
          <button type="button" class="btn btn--pill btn--red product-main__add-to-cart" data-add-to-cart data-add-to-cart-label>Add to cart &mdash; {{ current_variant.price | money }}</button>
        </div>

        <p class="product-main__checkout-note">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="4" y="10" width="16" height="10" rx="2"></rect>
            <path d="M8 10V7a4 4 0 0 1 8 0v3"></path>
          </svg>
          {{ section.settings.checkout_note }}
        </p>

        {%- if section.settings.show_pincode_checker -%}
          <form class="pincode-form" onsubmit="return false;">
            <input type="text" class="pincode-form__input" placeholder="{{ section.settings.pincode_placeholder | escape }}" inputmode="numeric" pattern="[0-9]*" maxlength="6" />
            <button type="submit" class="pincode-form__submit">{{ section.settings.pincode_button_label }}</button>
          </form>
        {%- endif -%}

        <div class="trust-badges">
          {% content_for "block", type: "trust_badge", id: "trust-1" %}
          {% content_for "block", type: "trust_badge", id: "trust-2" %}
          {% content_for "block", type: "trust_badge", id: "trust-3" %}
          {% content_for "block", type: "trust_badge", id: "trust-4" %}
        </div>

        {%- if upsell != blank -%}
          <div class="upsell">
            <span class="upsell__heading">{{ section.settings.upsell_heading }}</span>
            <div class="upsell-card">
              {%- if section.settings.upsell_badge != blank -%}
                <span class="badge badge--orange upsell-card__badge">{{ section.settings.upsell_badge }}</span>
              {%- endif -%}
              {%- if upsell.featured_image -%}
                {{ upsell.featured_image | image_url: width: 600 | image_tag: class: 'upsell-card__media', alt: upsell.title, loading: 'lazy' }}
              {%- endif -%}
              <div class="upsell-card__body">
                <h3 class="upsell-card__title">{{ upsell.title }}</h3>
                <p class="upsell-card__text">{{ section.settings.upsell_text }}</p>
                <div class="price">
                  <span class="price__sale">{{ upsell.price | money }}</span>
                  {%- if upsell.compare_at_price > upsell.price -%}
                    {%- assign upsell_saving = upsell.compare_at_price | minus: upsell.price -%}
                    <span class="price__compare">{{ upsell.compare_at_price | money }}</span>
                    <span class="badge badge--green">Save {{ upsell_saving | money }}</span>
                  {%- endif -%}
                </div>
              </div>
              <button type="button" class="btn btn--pill btn--red upsell-card__cta" data-add-to-cart>{{ section.settings.upsell_button_label }}</button>
            </div>
          </div>
        {%- endif -%}

      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product buy box",
  "tag": "div",
  "blocks": [
    { "type": "gallery_image" },
    { "type": "variant_option" },
    { "type": "trust_badge" }
  ],
  "settings": [
    { "type": "header", "content": "Product" },
    { "type": "product", "id": "product", "label": "Product", "info": "Leave blank on a product template to use the page's own product." },
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow_text", "label": "Eyebrow", "default": "Vada Pav Makhana · Chutney Pop" },
    { "type": "richtext", "id": "description", "label": "Short description" },
    { "type": "range", "id": "rating_value", "label": "Rating", "min": 0, "max": 5, "step": 0.1, "default": 4.3 },
    { "type": "number", "id": "rating_count", "label": "Rating count", "default": 1240 },
    { "type": "text", "id": "reviews_anchor", "label": "Reviews anchor id", "default": "reviews", "info": "The anchor id the product reviews section uses." },
    { "type": "text", "id": "tax_note", "label": "Tax note", "default": "Inclusive of all taxes" },
    { "type": "text", "id": "variants_label", "label": "Variant picker label", "default": "Quantity" },
    { "type": "text", "id": "checkout_note", "label": "Checkout note", "default": "Safe Checkout · 7-Days Return · 3-6 Day Delivery" },
    { "type": "checkbox", "id": "show_chat_button", "label": "Chat button on the photo", "default": true },
    { "type": "header", "content": "Pincode checker" },
    { "type": "checkbox", "id": "show_pincode_checker", "label": "Show pincode checker", "default": true },
    { "type": "text", "id": "pincode_placeholder", "label": "Placeholder", "default": "Enter pincode" },
    { "type": "text", "id": "pincode_button_label", "label": "Button label", "default": "Check" },
    { "type": "header", "content": "Upsell" },
    { "type": "product", "id": "upsell_product", "label": "Cross-sell product", "info": "Blank hides the whole Must Try card." },
    { "type": "text", "id": "upsell_heading", "label": "Upsell heading", "default": "Must Try" },
    { "type": "text", "id": "upsell_badge", "label": "Upsell badge", "default": "63% OFF + FREE Munchief bag" },
    { "type": "text", "id": "upsell_text", "label": "Upsell text", "default": "The crunch the flap, the full-on flavour scene" },
    { "type": "text", "id": "upsell_button_label", "label": "Upsell button", "default": "Add Combo to Cart" },
    { "type": "header", "content": "Style" },
    { "type": "range", "id": "thumbnail_columns", "label": "Thumbnails per row", "min": 3, "max": 6, "step": 1, "default": 4 },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "default", "label": "Cream / terracotta" },
        { "value": "pink", "label": "Pink" }
      ],
      "default": "default"
    },
    { "type": "header", "content": "Color" },
    { "type": "color", "id": "background_color", "label": "Section background", "default": "#ffffff" },
    { "type": "color", "id": "media_background", "label": "Image area", "default": "#f6efdd" },
    { "type": "color", "id": "title_color", "label": "Title", "default": "#2b2b2b" }
  ],
  "presets": [{ "name": "Product buy box" }]
}
{% endschema %}

{% comment %}
  Block: trust_badge
  Source: sections/product-main.html (section: product_main)

  One icon + label in the buy box's 4-up reassurance row (fast dispatch,
  secure payment, easy replacement, roasted not fried).

  Settings:
    - icon (select: dispatch | secure | replacement | roasted) — picks one
      of the four inline SVGs below; swap for an icon_picker if the theme
      ever ships an icon library
    - label (text)

  Shared classes: .trust-badge / .trust-badges live in components.css,
  loaded once in layout/theme.liquid. This block ships no CSS.
{% endcomment %}

<div class="trust-badge" {{ block.shopify_attributes }}>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    {%- case block.settings.icon -%}
      {%- when 'secure' -%}
        <path d="M12 2 4 5v6c0 5 3.4 8.7 8 11 4.6-2.3 8-6 8-11V5z"></path>
        <path d="m9 12 2 2 4-4"></path>
      {%- when 'replacement' -%}
        <path d="M17 2.1 21 6l-4 3.9"></path>
        <path d="M3 11V9a4 4 0 0 1 4-4h14"></path>
        <path d="m7 21.9-4-3.9 4-3.9"></path>
        <path d="M21 13v2a4 4 0 0 1-4 4H3"></path>
      {%- when 'roasted' -%}
        <path d="M12 22c4-.6 6-3.6 6-7 0-3-1.8-4.7-3-6.5.2 1.7-.6 2.7-1.4 3.3.3-2.2-.5-4.7-2.6-6.3.3 2-.4 3.6-1.8 5.1C7.8 12 7 13.6 7 15c0 3.4 2 6.4 5 7Z"></path>
        <line x1="4" y1="21" x2="20" y2="21"></line>
      {%- else -%}
        <rect x="1" y="7" width="14" height="10" rx="1"></rect>
        <path d="M15 10h4l3 3v4h-7z"></path>
        <circle cx="6" cy="19" r="1.6"></circle>
        <circle cx="17.5" cy="19" r="1.6"></circle>
    {%- endcase -%}
  </svg>
  <span>{{ block.settings.label }}</span>
</div>

{% schema %}
{
  "name": "Trust badge",
  "settings": [
    {
      "type": "select",
      "id": "icon",
      "label": "Icon",
      "options": [
        { "value": "dispatch", "label": "Fast dispatch (truck)" },
        { "value": "secure", "label": "Secure payment (shield)" },
        { "value": "replacement", "label": "Easy replacement (arrows)" },
        { "value": "roasted", "label": "Roasted not fried (flame)" }
      ],
      "default": "dispatch"
    },
    { "type": "text", "id": "label", "label": "Label", "default": "Fast dispatch" }
  ],
  "presets": [{ "name": "Trust badge" }]
}
{% endschema %}
